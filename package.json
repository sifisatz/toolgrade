{
  "name": "toolgrade",
  "version": "0.2.0",
  "description": "Eval-first quality gates for MCP servers: measure whether your tools make agents better than a no-tool baseline.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.6.0",
  "bin": {
    "toolgrade": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "example:server": "tsx examples/notes-server/server.ts",
    "demo": "tsx examples/offline-demo.ts",
    "prepare": "simple-git-hooks",
    "pre-commit": "pnpm typecheck && pnpm --dir web lint && pnpm --dir web typecheck"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm run pre-commit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^15.1.0",
    "picocolors": "^1.1.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "simple-git-hooks": "^2.14.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
