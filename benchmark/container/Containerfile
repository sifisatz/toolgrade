# Benchmark runner: the ToolGrade CLI plus the pinned MCP servers under test, nothing else.
# MCP servers run inside this container, never on the host.

# MCP Toolbox for Databases publishes no linux/arm64 binary, so build it from the pinned tag.
# Its Oracle driver needs cgo; building on bookworm keeps the binary's glibc in step with the runner.
FROM docker.io/library/golang:1.27-bookworm AS toolbox
RUN git clone --depth 1 --branch v1.17.0 https://github.com/googleapis/mcp-toolbox /src \
 && cd /src && test "$(git rev-parse HEAD)" = "45ed205cc8682ed066c82e0b65bcd0e8fc3becce" \
 && CGO_ENABLED=1 go build -trimpath -ldflags "-s -w" -o /out/toolbox .

FROM docker.io/library/node:24-bookworm-slim

# git, sqlite3 for the git and database fixtures; python3 for the Python reference servers;
# pandoc for mcp-pandoc, which shells out to the real binary.
RUN apt-get update && apt-get install -y --no-install-recommends git sqlite3 python3 pandoc ca-certificates \
 && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.13.9 /uv /uvx /usr/local/bin/
COPY --from=toolbox /out/toolbox /usr/local/bin/toolbox

# Python reference servers, pinned, installed as isolated tools on the image PATH.
ENV UV_TOOL_DIR=/opt/uv-tools UV_TOOL_BIN_DIR=/usr/local/bin UV_PYTHON_DOWNLOADS=never
RUN uv tool install --python python3 mcp-server-git==2026.11.11 \
 && uv tool install --python python3 mcp-server-time==2026.11.11 \
 && uv tool install --python python3 mcp-server-calculator==0.2.1 \
 && uv tool install --python python3 excel-mcp-server==2.3.2 \
 && uv tool install --python python3 mcp-pandoc==0.11.1

RUN corepack enable && corepack prepare pnpm@12.6.0 --activate
WORKDIR /toolgrade

# Dependency layer first so source edits do not reinstall everything.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY benchmark/package.json benchmark/package.json
COPY web/package.json web/package.json
RUN pnpm install --frozen-lockfile --filter . --filter ./benchmark

# Chromium for Playwright MCP, matching the pinned playwright version, with its system libraries.
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN benchmark/node_modules/.bin/playwright install --with-deps chromium \
 && rm -rf /var/lib/apt/lists/*

COPY tsconfig.json tsconfig.build.json vitest.config.ts ./
COPY src src
COPY test test
COPY examples examples
COPY benchmark benchmark
RUN pnpm build && bash benchmark/fixtures/build.sh && chown -R node:node /toolgrade/benchmark

USER node
ENV HOME=/tmp
ENTRYPOINT ["bash", "benchmark/run.sh"]
